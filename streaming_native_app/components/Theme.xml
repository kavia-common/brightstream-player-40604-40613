<?xml version="1.0" encoding="UTF-8"?>
<component name="RetroTheme" extends="Node">
  <interface>
    <!-- tokens: assocarray generated by Theme.brs tokens() with all color/font/retro values -->
    <field id="tokens" type="assocarray" alwaysNotify="true" />
    <!-- runtime toggles for retro effects; Theme.brs respects these when building tokens -->
    <field id="enableCRTvfx" type="boolean" value="true" alwaysNotify="true" />
    <field id="enableNeonBorders" type="boolean" value="true" alwaysNotify="true" />
  </interface>

  <!-- BrightScript backing logic that builds tokens based on Ocean Professional palette -->
  <script type="text/brightscript" uri="pkg:/source/Theme.brs" />

  <children>
    <!-- Focus/visual assets exposed to components that want to directly reference Posters -->
    <Poster id="focusRing" uri="pkg:/images/focus-ring.png" visible="false" />
    <!-- Retro overlays and borders -->
    <Poster id="scanlineOverlay" uri="pkg:/images/retro/scanline_overlay.png" visible="false" />
    <Poster id="neonBorderBlue" uri="pkg:/images/retro/neon_border_blue.png" visible="false" />
    <Poster id="neonBorderAmber" uri="pkg:/images/retro/neon_border_amber.png" visible="false" />
  </children>
</component>
