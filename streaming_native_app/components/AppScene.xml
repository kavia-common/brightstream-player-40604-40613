<?xml version="1.0" encoding="UTF-8"?>
<component name="BrightAppScene" extends="Scene">
  <interface>
    <field id="theme" type="assocarray" alwaysNotify="true" />
    <field id="navTarget" type="string" alwaysNotify="true" />
    <field id="selectedItem" type="assocarray" alwaysNotify="true" />
  </interface>

  <children>
    <!-- Theme provider -->
    <RetroTheme id="retroTheme" />

    <!-- Backdrop uses theme background -->
    <Rectangle
      id="bg"
      width="1920"
      height="1080"
      color="0x0e1e40FF" />

    <!-- Optional: retro scanline overlay (hidden by default, toggled in BRS) -->
    <Poster id="scanlines" uri="pkg:/images/retro/scanline_overlay.png" translation="[0,0]" width="1920" height="1080" visible="false" />

    <!-- Container where screens are swapped -->
    <Group id="contentHost" translation="[0,0]"/>
  </children>

  <script type="text/brightscript" uri="pkg:/source/AppScene.brs" />
</component>
